#version 460 core
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// BC1 (DXT1) to ASTC 4x4 LDR transcoder
// Each workgroup processes one 4x4 BC1 block (16 pixels)
// Output: ASTC 4x4 block (128 bits = 16 bytes)

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BcnInputBuffer {
    uint data[];
} bcnInput;

layout(set = 0, binding = 1, std430) writeonly buffer AstcOutputBuffer {
    uint data[];
} astcOutput;

// Push constants
layout(push_constant) uniform PushConstants {
    uint blockCount;
    uint formatInfo;
} pushConstants;

// Unpack RGB565 to 8-bit RGB
uvec3 unpackRgb565(uint packed) {
    uint r = (packed >> 11) & 0x1F;
    uint g = (packed >> 5) & 0x3F;
    uint b = packed & 0x1F;
    // Expand 5/6/5 bits to 8 bits
    return uvec3(
        (r << 3) | (r >> 2),
        (g << 2) | (g >> 4),
        (b << 3) | (b >> 2)
    );
}

// Simple ASTC encoding - single partition, 8-bit endpoints
void encodeAstcBlock(
    uint blockIndex,
    uvec3 color0, uvec3 color1,
    uint indices // 32 bits = 16 x 2-bit indices
) {
    // ASTC 4x4 block header (simplified single-partition mode)
    // 128 bits = 16 bytes
    // We'll encode a basic block with 2 colors and weights
    
    uint64_t blockLow = 0;
    uint64_t blockHigh = 0;
    
    // Block mode: single partition, 8-bit LDR RGB
    // Mode bits: 1100 (single partition, 8-bit, RGB)
    blockLow = 0x000C;
    
    // Color endpoints (RGB8)
    blockLow |= uint64_t(color0.r) << 16;
    blockLow |= uint64_t(color0.g) << 24;
    blockLow |= uint64_t(color0.b) << 32;
    blockLow |= uint64_t(color1.r) << 40;
    blockLow |= uint64_t(color1.g) << 48;
    blockLow |= uint64_t(color1.b) << 56;
    
    // Weights for 16 pixels (6 bits each = 96 bits)
    for (int i = 0; i < 16; i++) {
        uint idx = (indices >> (i * 2)) & 0x3;
        // Map BC1 index to ASTC weight (0 or 64)
        uint weight = (idx == 0 || idx == 1) ? 0 : 64;
        if (idx == 2) weight = 43;  // 2/3
        if (idx == 3) weight = 21;  // 1/3
        blockHigh |= uint64_t(weight) << (i * 6);
    }
    
    // Write 16-byte ASTC block
    uint baseIdx = blockIndex * 4; // 4 uints = 16 bytes
    astcOutput.data[baseIdx + 0] = uint(blockLow & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 1] = uint((blockLow >> 32) & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 2] = uint(blockHigh & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 3] = uint((blockHigh >> 32) & 0xFFFFFFFF);
}

void main() {
    uint blockIndex = gl_GlobalInvocationID.x;
    if (blockIndex >= pushConstants.blockCount)
        return;
    
    // Read BC1 block (2 uints = 8 bytes)
    uint bc1Low = bcnInput.data[blockIndex * 2 + 0];
    uint bc1High = bcnInput.data[blockIndex * 2 + 1];
    
    // Unpack color endpoints
    uint color0Packed = bc1Low & 0xFFFF;
    uint color1Packed = (bc1Low >> 16) & 0xFFFF;
    uint indices = bc1High;
    
    uvec3 color0 = unpackRgb565(color0Packed);
    uvec3 color1 = unpackRgb565(color1Packed);
    
    // Ensure color0 >= color1 for BC1 ordering
    if (color0.r + color0.g + color0.b < color1.r + color1.g + color1.b) {
        uvec3 temp = color0;
        color0 = color1;
        color1 = temp;
    }
    
    encodeAstcBlock(blockIndex, color0, color1, indices);
}