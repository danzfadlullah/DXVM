#version 460 core
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// BC4 (single channel) / BC5 (dual channel) to ASTC 4x4 LDR
// BC4: 8 bytes = 2 x 8-bit endpoints + 48 bits (16 x 3-bit indices)
// BC5: 16 bytes = 2 x BC4 blocks (R and G channels)

#define BC4_MODE 0
#define BC5_MODE 1

// Set this based on which shader variant is compiled
const int MODE = BC4_MODE;

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BcnInputBuffer {
    uint data[];
} bcnInput;

layout(set = 0, binding = 1, std430) writeonly buffer AstcOutputBuffer {
    uint data[];
} astcOutput;

// Push constants
layout(push_constant) uniform PushConstants {
    uint blockCount;
    uint formatInfo;
} pushConstants;

// Unpack 3-bit index to 8-bit
uint unpackIndex3bit(uint idx) {
    return (idx << 5) | (idx << 2) | (idx >> 1);
}

void encodeAstcSingleChannel(
    uint blockIndex,
    uint endpoint0, uint endpoint1,
    uint indices // 48 bits = 16 x 3-bit
) {
    uint64_t blockLow = 0;
    uint64_t blockHigh = 0;
    
    blockLow = 0x000C; // Basic block mode
    
    // Single channel endpoints (R channel)
    blockLow |= uint64_t(endpoint0) << 16;
    blockLow |= uint64_t(endpoint1) << 24;
    
    // Weights (16 x 6 bits)
    for (int i = 0; i < 16; i++) {
        uint idx = (indices >> (i * 3)) & 0x7;
        // Map 3-bit index to weight (0-64 range)
        uint weight = (idx * 64) / 7;
        blockHigh |= uint64_t(weight) << (i * 6);
    }
    
    uint baseIdx = blockIndex * 4;
    astcOutput.data[baseIdx + 0] = uint(blockLow & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 1] = uint((blockLow >> 32) & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 2] = uint(blockHigh & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 3] = uint((blockHigh >> 32) & 0xFFFFFFFF);
}

void main() {
    uint blockIndex = gl_GlobalInvocationID.x;
    if (blockIndex >= pushConstants.blockCount)
        return;
    
    if (MODE == BC4_MODE) {
        // BC4: 8 bytes per block = 2 uints
        uint offset = blockIndex * 2;
        uint endpoints = bcnInput.data[offset + 0];
        uint indices = bcnInput.data[offset + 1];
        
        uint endpoint0 = endpoints & 0xFF;
        uint endpoint1 = (endpoints >> 8) & 0xFF;
        
        if (endpoint0 < endpoint1) {
            uint temp = endpoint0;
            endpoint0 = endpoint1;
            endpoint1 = temp;
        }
        
        encodeAstcSingleChannel(blockIndex, endpoint0, endpoint1, indices);
    } else {
        // BC5: 16 bytes per block = 4 uints (2 x BC4)
        uint offset = blockIndex * 4;
        
        // R channel
        uint endpointsR = bcnInput.data[offset + 0];
        uint indicesR = bcnInput.data[offset + 1];
        uint endpoint0R = endpointsR & 0xFF;
        uint endpoint1R = (endpointsR >> 8) & 0xFF;
        
        // G channel  
        uint endpointsG = bcnInput.data[offset + 2];
        uint indicesG = bcnInput.data[offset + 3];
        uint endpoint0G = endpointsG & 0xFF;
        uint endpoint1G = (endpointsG >> 8) & 0xFF;
        
        // For BC5, we'd encode as two-channel ASTC
        // Simplified: encode R channel only for now
        if (endpoint0R < endpoint1R) {
            uint temp = endpoint0R;
            endpoint0R = endpoint1R;
            endpoint1R = temp;
        }
        encodeAstcSingleChannel(blockIndex, endpoint0R, endpoint1R, indicesR);
    }
}