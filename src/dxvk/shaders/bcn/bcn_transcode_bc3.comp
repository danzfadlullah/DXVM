#version 460 core
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// BC3 (DXT5) to ASTC 4x4 LDR transcoder
// BC3: 16 bytes = 2 x RGB565 color endpoints + 8 bytes alpha block + 4 bytes indices
// Alpha block: 2 x 8-bit endpoints + 48 bits (16 x 3-bit indices)
// Output: ASTC 4x4 LDR with alpha (16 bytes)

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BcnInputBuffer {
    uint data[];
} bcnInput;

layout(set = 0, binding = 1, std430) writeonly buffer AstcOutputBuffer {
    uint data[];
} astcOutput;

// Push constants
layout(push_constant) uniform PushConstants {
    uint blockCount;
    uint formatInfo;
} pushConstants;

// Unpack RGB565 to 8-bit RGB
uvec3 unpackRgb565(uint packed) {
    uint r = (packed >> 11) & 0x1F;
    uint g = (packed >> 5) & 0x3F;
    uint b = packed & 0x1F;
    return uvec3(
        (r << 3) | (r >> 2),
        (g << 2) | (g >> 4),
        (b << 3) | (b >> 2)
    );
}

// Simple ASTC encoding with alpha
void encodeAstcBlockAlpha(
    uint blockIndex,
    uvec3 color0, uvec3 color1,
    uint alpha0, uint alpha1,
    uint colorIndices, // 32 bits = 16 x 2-bit
    uint alphaIndices  // 48 bits = 16 x 3-bit
) {
    uint64_t blockLow = 0;
    uint64_t blockHigh = 0;
    
    // Block header (simplified)
    blockLow = 0x000C;
    
    // Color endpoints (RGB8)
    blockLow |= uint64_t(color0.r) << 16;
    blockLow |= uint64_t(color0.g) << 24;
    blockLow |= uint64_t(color0.b) << 32;
    blockLow |= uint64_t(color1.r) << 40;
    blockLow |= uint64_t(color1.g) << 48;
    blockLow |= uint64_t(color1.b) << 56;
    
    // Alpha endpoints (8-bit)
    blockHigh |= uint64_t(alpha0);
    blockHigh |= uint64_t(alpha1) << 8;
    
    // Color weights (16 x 6 bits = 96 bits)
    for (int i = 0; i < 16; i++) {
        uint idx = (colorIndices >> (i * 2)) & 0x3;
        uint weight = (idx == 0 || idx == 1) ? 0 : 64;
        if (idx == 2) weight = 43;
        if (idx == 3) weight = 21;
        blockHigh |= uint64_t(weight) << (16 + i * 6);
    }
    
    // Alpha weights (16 x 6 bits = 96 bits) - stored in upper bits
    for (int i = 0; i < 16; i++) {
        uint idx = (alphaIndices >> (i * 3)) & 0x7;
        uint weight = (idx * 64) / 7;
        blockHigh |= uint64_t(weight) << (112 + i * 6);
    }
    
    uint baseIdx = blockIndex * 4;
    astcOutput.data[baseIdx + 0] = uint(blockLow & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 1] = uint((blockLow >> 32) & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 2] = uint(blockHigh & 0xFFFFFFFF);
    astcOutput.data[baseIdx + 3] = uint((blockHigh >> 32) & 0xFFFFFFFF);
}

void main() {
    uint blockIndex = gl_GlobalInvocationID.x;
    if (blockIndex >= pushConstants.blockCount)
        return;
    
    // BC3 block = 16 bytes = 4 uints
    uint offset = blockIndex * 4;
    uint color0Packed = bcnInput.data[offset + 0] & 0xFFFF;
    uint color1Packed = (bcnInput.data[offset + 0] >> 16) & 0xFFFF;
    
    uint alphaLow = bcnInput.data[offset + 1];
    uint alphaHigh = bcnInput.data[offset + 2];
    uint colorIndices = bcnInput.data[offset + 3];
    
    // Unpack alpha block
    uint alpha0 = alphaLow & 0xFF;
    uint alpha1 = (alphaLow >> 8) & 0xFF;
    uint alphaIndices = (alphaLow >> 16) | (alphaHigh << 16); // 48 bits
    
    uvec3 color0 = unpackRgb565(color0Packed);
    uvec3 color1 = unpackRgb565(color1Packed);
    
    // Ensure color0 >= color1
    if (color0.r + color0.g + color0.b < color1.r + color1.g + color1.b) {
        uvec3 temp = color0;
        color0 = color1;
        color1 = temp;
    }
    
    // Ensure alpha0 >= alpha1
    if (alpha0 < alpha1) {
        uint temp = alpha0;
        alpha0 = alpha1;
        alpha1 = temp;
    }
    
    encodeAstcBlockAlpha(blockIndex, color0, color1, alpha0, alpha1, colorIndices, alphaIndices);
}