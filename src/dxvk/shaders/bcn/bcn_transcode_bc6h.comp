#version 460 core
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// BC6H (HDR) to ASTC 6x6 SFLOAT transcoder
// BC6H: 16 bytes = 2 x half-float endpoints + indices
// Mode 0: 1 subset, 10-bit indices
// Mode 1: 2 subsets, 8-bit indices
// Output: ASTC 6x6 SFLOAT (HDR)

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BcnInputBuffer {
    uint data[];
} bcnInput;

layout(set = 0, binding = 1, std430) writeonly buffer AstcOutputBuffer {
    uint data[];
} astcOutput;

// Push constants
layout(push_constant) uniform PushConstants {
    uint blockCount;
    uint formatInfo;
} pushConstants;

// Decode half-float (16-bit) to float
float unpackHalf(uint16_t h) {
    uint sign = (h >> 15) & 1u;
    uint exp = (h >> 10) & 0x1Fu;
    uint mant = h & 0x3FFu;
    
    if (exp == 0u) {
        if (mant == 0u) return (sign != 0u) ? -0.0 : 0.0;
        // Subnormal
        return (sign != 0u ? -1.0 : 1.0) * float(mant) * pow(2.0, -24.0);
    } else if (exp == 31u) {
        return (sign != 0u) ? -1.0/0.0 : 1.0/0.0;
    } else {
        float f = ldexp(float(mant) / 1024.0 + 1.0, int(exp) - 15);
        return (sign != 0u) ? -f : f;
    }
}

// Pack float to half (for storage)
uint16_t packHalf(float f) {
    if (f == 0.0) return uint16_t(0);
    // Use bit manipulation instead of isinf/isnan
    uint bits = floatBitsToUint(f);
    uint exp = (bits >> 23) & 0xFFu;
    uint mant = bits & 0x7FFFFFu;
    
    if (exp == 255u) {
        if (mant == 0u) return uint16_t(0x7C00u | ((bits & 0x80000000u) >> 16));
        return uint16_t(0x7E00u);
    }
    
    int sign = int((bits >> 31) & 1u);
    int expVal = int(exp) - 127 + 15; // Convert bias 127 to 15
    
    if (expVal <= 0) {
        // Subnormal
        return uint16_t(sign << 15);
    }
    if (expVal >= 31) {
        return uint16_t((sign << 15) | 0x7C00u);
    }
    
    uint mantBits = (bits & 0x7FFFFFu) >> 13u; // 23 -> 10 bits
    return uint16_t((sign << 15) | (uint(expVal) << 10) | mantBits);
}

void encodeAstcHdr(
    uint blockIndex,
    vec3 color0, vec3 color1,
    uint indices // complex
) {
    // ASTC 6x6 SFLOAT block = 16 bytes
    // This is a placeholder for HDR encoding
    
    uint baseIdx = blockIndex * 4;
    
    // Store endpoints as half-floats
    uint ep0r = packHalf(color0.r);
    uint ep0g = packHalf(color0.g);
    uint ep0b = packHalf(color0.b);
    uint ep1r = packHalf(color1.r);
    uint ep1g = packHalf(color1.g);
    uint ep1b = packHalf(color1.b);
    
    astcOutput.data[baseIdx + 0] = (ep0r << 16) | ep0g;
    astcOutput.data[baseIdx + 1] = (ep0b << 16) | ep1r;
    astcOutput.data[baseIdx + 2] = (ep1g << 16) | ep1b;
    astcOutput.data[baseIdx + 3] = indices;
}

void main() {
    uint blockIndex = gl_GlobalInvocationID.x;
    if (blockIndex >= pushConstants.blockCount)
        return;
    
    // BC6H: 16 bytes = 4 uints
    uint offset = blockIndex * 4;
    
    // Parse header
    uint header = bcnInput.data[offset + 0] & 0xFF;
    uint mode = header & 0x1u;
    
    // Extract endpoints (simplified)
    uint word1 = bcnInput.data[offset + 1];
    uint word2 = bcnInput.data[offset + 2];
    uint word3 = bcnInput.data[offset + 3];
    
    // Endpoints stored as half-floats
    uint ep0r = word1 & 0xFFFF;
    uint ep0g = (word1 >> 16) & 0xFFFF;
    uint ep0b = word2 & 0xFFFF;
    uint ep1r = (word2 >> 16) & 0xFFFF;
    uint ep1g = word3 & 0xFFFF;
    uint ep1b = (word3 >> 16) & 0xFFFF;
    
    vec3 color0 = vec3(unpackHalf(uint16_t(ep0r)), unpackHalf(uint16_t(ep0g)), unpackHalf(uint16_t(ep0b)));
    vec3 color1 = vec3(unpackHalf(uint16_t(ep1r)), unpackHalf(uint16_t(ep1g)), unpackHalf(uint16_t(ep1b)));
    
    encodeAstcHdr(blockIndex, color0, color1, word3);
}